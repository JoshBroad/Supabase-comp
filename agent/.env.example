# Supabase project URL (e.g. https://xxxx.supabase.co or http://localhost:54321 for local dev)
SUPABASE_URL=http://localhost:54321

# Service-role key — admin access, REQUIRED for exec_sql and control-plane RPCs. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter API key for LLM access (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: override the LLM model routed through OpenRouter
# OPENROUTER_MODEL=google/gemini-3-pro-preview

# Optional: set to "true" to log full LLM prompts/responses to stdout
# LLM_DEBUG=false

# Port the agent listens on
PORT=3001
