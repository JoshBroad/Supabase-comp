# Supabase project URL (e.g. https://xxxx.supabase.co or http://localhost:54321 for local dev)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the agent's REST API (also used for /sessions, /events, /graphql proxies)
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3001

# Base URL the browser uses to trigger agent runs (usually the same as above)
NEXT_PUBLIC_AGENT_URL=http://localhost:3001
